# ─── Downloader Engine Selection ──────────────────────────────────────────────
#
# Controls which extraction backend powers the app.
#
# Options:
#   ytdlp   (default) — Uses yt-dlp binary via youtube-dl-exec
#                        ✅ Best for: Local dev, VPS, Docker containers
#                        ❌ Does NOT work on: Vercel, serverless functions
#                        Requires: yt-dlp binary on PATH (https://github.com/yt-dlp/yt-dlp)
#
#   cobalt            — Uses a self-hosted Cobalt API instance (HTTP only, no binary)
#                        ✅ Best for: Vercel, any serverless platform
#                        Requires: COBALT_API_URL + optionally COBALT_API_KEY
#                        Setup guide: https://github.com/imputnet/cobalt/blob/main/docs/run-an-instance.md
#
DOWNLOADER_ENGINE=ytdlp

# ─── Cobalt Engine Settings (required only when DOWNLOADER_ENGINE=cobalt) ──────
# URL of your self-hosted Cobalt instance (no trailing slash).
COBALT_API_URL=https://your-cobalt-instance.example.com
COBALT_API_KEY=

# ─── Custom Branding & Domain ─────────────────────────────────────────────────
# Customize your website name (shown in Navbar, Hero, Meta Title, and Footer)
NEXT_PUBLIC_SITE_NAME="NX Downloader"

# Your domain or server IP (without http/https)
DOMAIN=localhost:3000
NEXT_PUBLIC_DOMAIN=localhost:3000

# Full canonical URL for SEO and sitemap generation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional Monetization / Ad Gate ──────────────────────────────────────────
# Set to true if you want to require users to click an external link for >200MB downloads
NEXT_PUBLIC_AD_GATE_ENABLED=false
NEXT_PUBLIC_AD_DIRECT_URL=

# ─── Admin Ops & Monitoring Panel ─────────────────────────────────────────────
# Security PIN required to access /ops-panel-x99 for monitoring and cookie uploads
ADMIN_PIN=9988

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
